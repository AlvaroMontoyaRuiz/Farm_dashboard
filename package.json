{
  "name": "farm-inventory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --d1 DB=farm-inventory-db",
    "db:local:init": "wrangler d1 execute farm-inventory-db --local --file=./migrations/0001_init.sql",
    "db:local:seed": "wrangler d1 execute farm-inventory-db --local --file=./migrations/0002_seed.sql",
    "db:remote:init": "wrangler d1 execute farm-inventory-db --remote --file=./migrations/0001_init.sql",
    "db:remote:seed": "wrangler d1 execute farm-inventory-db --remote --file=./migrations/0002_seed.sql",
    "db:local:update": "wrangler d1 execute farm-inventory-db --local --file=./migrations/0003_weights_and_bulto_types.sql",
    "db:remote:update": "wrangler d1 execute farm-inventory-db --remote --file=./migrations/0003_weights_and_bulto_types.sql",
    "db:local:reset": "wrangler d1 execute farm-inventory-db --local --file=./scripts/reset-data.sql",
    "db:remote:reset": "wrangler d1 execute farm-inventory-db --remote --file=./scripts/reset-data.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "vite": "^5.3.5",
    "wrangler": "^3.68.0"
  }
}
